APP_ENV=local
APP_NAME=hafriyat-api

# JWT
# Üretimde Railway env var olarak güçlü bir secret verin.
JWT_SECRET_KEY=CHANGE_ME_IN_PROD
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS (frontend domain’lerini virgülle ayır)
# CORS_ALLOW_ORIGINS=https://your-frontend.railway.app,https://yourdomain.com
CORS_ALLOW_ORIGINS=

# MySQL
# Railway kullanırken genelde tek URL verilir; biz yine de alanları ayrı tuttuk.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=hafriyat

# Alternatif: tek parça DSN (varsa önceliklidir)
# MYSQL_DSN=mysql+pymysql://root:changeme@localhost:3306/hafriyat?charset=utf8mb4
